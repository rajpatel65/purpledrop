import fs from 'node:fs';
import ts from 'typescript';
import vm from 'node:vm';
import assert from 'node:assert/strict';
const src=fs.readFileSync('src/components/HomeCalculator.tsx','utf8');
const fn=src.slice(src.indexOf('export function estimateLeadValue'),src.indexOf('const money')).replace('export function','function');
const js=ts.transpile(fn,{target:ts.ScriptTarget.ES2022});
const ctx={};vm.createContext(ctx);vm.runInContext(js,ctx);
const calc=ctx.estimateLeadValue;
assert.equal(calc(100,20,500,10).additionalRevenue,1000);
assert.equal(calc(100,20,500,10).baselineRevenue,10000);
assert.equal(calc(100,20,500,10).scenarioRevenue,11000);
assert.equal(calc(100,0,500,10).additionalRevenue,0);
assert.equal(calc(0,20,500,10).baselineRevenue,0);
assert.equal(calc(100,20,0,10).additionalRevenue,0);
assert.equal(calc(100,20,500,0).additionalRevenue,0);
for (const values of [[-1,20,500,10],[100,101,500,10],[NaN,20,500,10],[Infinity,20,500,10]]) assert.equal(calc(...values),null);
assert.equal(calc(10,2.5,123.45,2).additionalRevenue,6.1725);
console.log('PASS calculator: baseline, scenario, four zero cases, invalid bounds/nonfinite, fractional inputs (12 assertions)');
