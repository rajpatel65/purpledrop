{
  "name": "purpledrop-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "test:client": "node scripts/test-soc2-client.mjs",
    "test:functions": "deno run --allow-env --allow-read --allow-write scripts/test-soc2-functions.ts",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=purpledrop-newsite",
    "deploy:preview": "npm run build && npx wrangler pages deploy dist --project-name=purpledrop-newsite --branch=preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^0.364.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.6.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
