# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# Local development only. Never enables demo codes in production.
# VITE_SOC2_DEMO_MODE=true

# Server-only Supabase Edge Function secret (NOT a Pages build variable)
# Resend API Key (for email verification)
# Get from resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
